    "Title": "\u0426\u0432\u0435\u0442\u043E\u043A \u0434\u043B\u044F \u0441\u0442\u0440\u0430\u0436\u0430",
    "Characters": [
      {
        "Id": "11111111-1111-1111-1111-111111111111",
        "Name": "\u041C\u0438\u043B\u0430"
      },
      {
        "Id": "22222222-2222-2222-2222-222222222222",
        "Name": "\u0421\u0442\u0440\u0430\u0436"
      }
    ],
    "Nodes": [
      {
        "Id": "00000000-0000-0000-0000-000000000001",
        "CharacterId": "11111111-1111-1111-1111-111111111111",
        "Text": "\u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C \u043D\u0430\u0439\u0442\u0438 \u0446\u0432\u0435\u0442\u043E\u043A \u0434\u043B\u044F \u0441\u0442\u0440\u0430\u0436\u0430?",
        "Choices": [
          {
            "Id": "10000000-0000-0000-0000-000000000001",
            "Text": "\u041E\u0431\u0435\u0449\u0430\u044E \u043F\u043E\u043C\u043E\u0447\u044C",
            "TargetNodeId": "00000000-0000-0000-0000-000000000002",
            "ShowCondition": null,
            "FlagChanges": [
              {
                "FlagName": "quest",
                "NewValue": true
              }
            ]
          },
          {
            "Id": "10000000-0000-0000-0000-000000000002",
            "Text": "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441",
            "TargetNodeId": "00000000-0000-0000-0000-000000000006",
            "ShowCondition": null,
            "FlagChanges": []
          }
        ],
        "IsEnding": false,
        "ShowCondition": null,
        "NextNodeId": null
      },
      {
        "Id": "00000000-0000-0000-0000-000000000002",
        "CharacterId": "22222222-2222-2222-2222-222222222222",
        "Text": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E. \u0417\u0430\u0433\u043B\u044F\u043D\u0438 \u0432 \u0441\u0430\u0434.",
        "Choices": [],
        "IsEnding": false,
        "ShowCondition": {
          "FlagName": "quest",
          "ExpectedValue": true
        },
        "NextNodeId": "00000000-0000-0000-0000-000000000003"
      },
      {
        "Id": "00000000-0000-0000-0000-000000000003",
        "CharacterId": "11111111-1111-1111-1111-111111111111",
        "Text": "\u0422\u044B \u043D\u0430\u0448\u043B\u0430 \u0446\u0432\u0435\u0442\u043E\u043A?",
        "Choices": [
          {
            "Id": "10000000-0000-0000-0000-000000000003",
            "Text": "\u041E\u0442\u0434\u0430\u0442\u044C \u0446\u0432\u0435\u0442\u043E\u043A",
            "TargetNodeId": "00000000-0000-0000-0000-000000000004",
            "ShowCondition": {
              "FlagName": "has_flower",
              "ExpectedValue": true
            },
            "FlagChanges": [
              {
                "FlagName": "has_flower",
                "NewValue": false
              },
              {
                "FlagName": "flower_given",
                "NewValue": true
              }
            ]
          },
          {
            "Id": "10000000-0000-0000-0000-000000000004",
            "Text": "\u041F\u043E\u043A\u0430 \u043D\u0435\u0442",
            "TargetNodeId": "00000000-0000-0000-0000-000000000005",
            "ShowCondition": null,
            "FlagChanges": []
          }
        ],
        "IsEnding": false,
        "ShowCondition": null,
        "NextNodeId": null
      },
      {
        "Id": "00000000-0000-0000-0000-000000000004",
        "CharacterId": "22222222-2222-2222-2222-222222222222",
        "Text": "\u0421\u043F\u0430\u0441\u0438\u0431\u043E \u0437\u0430 \u0446\u0432\u0435\u0442\u043E\u043A!",
        "Choices": [],
        "IsEnding": true,
        "ShowCondition": {
          "FlagName": "flower_given",
          "ExpectedValue": true
        },
        "NextNodeId": null
      },
      {
        "Id": "00000000-0000-0000-0000-000000000005",
        "CharacterId": "11111111-1111-1111-1111-111111111111",
        "Text": "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F, \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0451\u0448\u044C \u0446\u0432\u0435\u0442\u043E\u043A.",
        "Choices": [],
        "IsEnding": true,
        "ShowCondition": null,
        "NextNodeId": null
      },
      {
        "Id": "00000000-0000-0000-0000-000000000006",
        "CharacterId": "11111111-1111-1111-1111-111111111111",
        "Text": "\u0425\u043E\u0440\u043E\u0448\u043E, \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C \u043F\u043E\u0437\u0436\u0435...",
