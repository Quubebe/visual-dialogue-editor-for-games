<Window
    x:Class="Dialogue.Editor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Редактор диалогов"
    Width="900"
    Height="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <Button
                Width="120"
                Height="30"
                Margin="8,0,0,0"
                Click="Preview_Click"
                Content="Предпросмотр"/>
            <Button
                Width="100"
                Height="30"
                Margin="0,0,8,0"
                Click="OpenProject_Click"
                Content="Открыть"/>
            <Button
                Width="100"
                Height="30"
                Click="SaveProject_Click"
                Content="Сохранить"/>

            <Button Content="Проверить"
                    Width="100"
                    Height="30"
                    Margin="8,0,0,0"
                    Command="{Binding ValidateCommand}"/>
        </StackPanel>
        <Grid Grid.Row="1"
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock
                Margin="0,0,0,8"
                FontSize="18"
                FontWeight="Bold"
                Text="Реплики"/>
            <Button
                Grid.Row="1"
                Margin="0,0,0,8"
                Command="{Binding AddNodeCommand}"
                Content="Добавить реплику"/>
            <ListBox
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,0,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                DisplayMemberPath="Text"
                ItemsSource="{Binding Nodes}"
                SelectedItem="{Binding SelectedNode, Mode=TwoWay}"/>
            <GroupBox Grid.Row="3"
                      Header="Последняя проверка"
                      Margin="0,10,0,0">
                <ListBox ItemsSource="{Binding ValidationIssues}"
                         MaxHeight="160"
                         SelectionChanged="ValidationIssues_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="2"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Grid.Column="2">
                <GroupBox Header="Персонажи"
                          Margin="0,0,0,16">
                    <StackPanel Margin="8">
                        <Button Content="Добавить персонажа"
                                Command="{Binding AddCharacterCommand}"
                                HorizontalAlignment="Left"
                                Padding="10,4"
                                Margin="0,0,0,8"/>

                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Name,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,0,6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                <TextBlock
                    Margin="0,0,0,12"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="Выбранная реплика"/>
                <TextBlock Text="Начальная реплика:"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding StartNode.Text}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,6"/>
                <Button Content="Сделать выбранную реплику начальной"
                        Command="{Binding SetStartNodeCommand}"
                        HorizontalAlignment="Left"
                        Padding="10,4"
                        Margin="0,0,0,12"/>
                <TextBox
                    Height="120"
                    AcceptsReturn="True"
                    Text="{Binding SelectedNode.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto"/>
                <TextBlock Text="Говорящий"
                           Margin="0,12,0,4"/>
                <ComboBox ItemsSource="{Binding Characters}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedNode.CharacterId, Mode=TwoWay}"/>
                <Button Content="Без персонажа"
                        Command="{Binding ClearCharacterCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Padding="8,3"/>
                <CheckBox
                    Margin="0,12,0,0"
                    Content="Завершает разговор"
                    IsChecked="{Binding SelectedNode.IsEnding, Mode=TwoWay}"/>
                <GroupBox Margin="0,16,0,0"
                          Header="Условие показа реплики">
                    <StackPanel Margin="8">
                        <CheckBox Content="Использовать условие"
                                  IsChecked="{Binding SelectedNode.HasShowCondition, Mode=TwoWay}"/>
                        <StackPanel Margin="0,8,0,0"
                                    IsEnabled="{Binding SelectedNode.HasShowCondition}">
                            <TextBlock Text="Имя флага"/>
                            <TextBox Text="{Binding SelectedNode.ShowCondition.FlagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox
                                Margin="0,8,0,0"
                                Content="Ожидаемое значение: true"
                                IsChecked="{Binding SelectedNode.ShowCondition.ExpectedValue, Mode=TwoWay}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
                <TextBlock
                    Margin="0,20,0,8"
                    FontWeight="Bold"
                    Text="Ответы"/>
                <Button
                    Margin="0,0,0,8"
                    Command="{Binding AddChoiceCommand}"
                    Content="Добавить ответ"/>
                <ItemsControl ItemsSource="{Binding SelectedNode.Choices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Текст ответа"/>
                                <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,6,0,2"
                                           Text="Следующая реплика"/>
                                <ComboBox
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding DataContext.Nodes, RelativeSource={RelativeSource AncestorType=Window}}"
                                    SelectedValue="{Binding TargetNodeId, Mode=TwoWay}"
                                    SelectedValuePath="Id"/>

                                <GroupBox Margin="0,10,0,0"
                                          Header="Условие показа ответа">
                                    <StackPanel Margin="8">
                                        <CheckBox Content="Использовать условие"
                                                  IsChecked="{Binding HasShowCondition, Mode=TwoWay}"/>

                                        <StackPanel Margin="0,8,0,0"
                                                    IsEnabled="{Binding HasShowCondition}">
                                            <TextBlock Text="Имя флага"/>
                                            <TextBox Text="{Binding ShowCondition.FlagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                            <CheckBox
                                                Margin="0,8,0,0"
                                                Content="Ожидаемое значение: true"
                                                IsChecked="{Binding ShowCondition.ExpectedValue, Mode=TwoWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Margin="0,10,0,0"
                                          Header="Последствие выбора">
                                    <StackPanel Margin="8">
                                        <Button Command="{Binding AddFlagChangeCommand}"
                                                Content="Добавить изменение флага"/>

                                        <ItemsControl ItemsSource="{Binding FlagChanges}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,8,0,0">
                                                        <TextBlock Text="Имя изменяемого флага"/>
                                                        <TextBox Text="{Binding FlagName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <CheckBox
                                                            Margin="0,6,0,0"
                                                            Content="Новое значение: true"
                                                            IsChecked="{Binding NewValue, Mode=TwoWay}"/>
                                                        <Button
                                                            Margin="0,6,0,0"
                                                            Command="{Binding DataContext.RemoveFlagChangeCommand, RelativeSource={RelativeSource AncestorType=GroupBox}}"
                                                            CommandParameter="{Binding}"
                                                            Content="Удалить изменение"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </GroupBox>

                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,20,0,4"
                           Text="ID карточки"/>
                <TextBlock Text="{Binding SelectedNode.Id}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
